{
  "name": "Rust Dev Environment",
  // Built from a Dockerfile rather than pulled as a plain `image` so the GUI runtime packages
  // become a cached layer. The devcontainer's identity is a hash of the host workspace path, so
  // moving the project forces a rebuild; Docker's layer cache is keyed on content instead, and
  // carries those packages across the move rather than re-downloading them.
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "default"
    },
    "ghcr.io/devcontainers/features/node:2": {}
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Not postCreateCommand: the display has to be re-established after a container restart too.
  "postStartCommand": "bash .devcontainer/start-xvfb.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer"
      ]
    }
  },
  "containerEnv": {
    // Headless X display served by start-xvfb.sh. Nothing is shown on the host; the app is
    // observed through screenshots (`import`) and driven through `xdotool`.
    "DISPLAY": ":99",
    // Vulkan refuses to initialise without this, so it is required rather than tidiness.
    "XDG_RUNTIME_DIR": "/tmp/xdg-runtime",
    // Tells the desktop portal which backend to use, for `rfd`'s file dialogs.
    "XDG_CURRENT_DESKTOP": "GNOME"
  },
  "runArgs": [
    "--env-file",
    ".devcontainer/devcontainer.env"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind",
    "source=${localEnv:HOME}/.omp,target=/home/vscode/.omp,type=bind,consistency=cached",
    // "source=/home/pvillela/DEV/Rust/basic-stats,target=/workspaces/basic-stats,type=bind,consistency=cached,readonly"
  ]
}
